# Copy to .env and fill in. Never commit .env.

# NASA FIRMS MAP_KEY (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Optional: Planetary Computer subscription key (raises rate limits; anonymous access works).
PC_SDK_SUBSCRIPTION_KEY=

# Future: Google Earth Engine provider
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_PATH=
GEE_PROJECT=

# Optional override for the config file location
STUBBLE_CONFIG=
